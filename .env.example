# Copy this file to .env.local and adjust if you need to. The defaults work with
# the database that `docker compose up -d` starts, so for most people the copy
# is the whole setup:
#
#   cp .env.example .env.local
#   docker compose up -d
#   npm run db:reset
#   npm run dev
#
# .env.local is gitignored. Never put a real credential in this file: it is
# committed, and the project bans shared and personally-paid keys outright.

# The local Docker database. Port 15432 rather than 5432 so it cannot collide
# with a Postgres you already run for something else, and below 49152 so
# Windows cannot reserve it at startup (docker-compose.yml says why).
# `npm test` uses this same server: it creates databases named `dk_test_...`
# beside this one, drops them when it finishes, and never reads or writes this
# one.
DATABASE_URL=postgres://daykeeper:daykeeper_local_dev@localhost:15432/daykeeper

# Only for a database that is not on this machine.
#
# A hosted Postgres sits behind a pooler whose certificate is signed by the
# provider's own authority, which Node does not trust by default, so the
# connection fails with SELF_SIGNED_CERT_IN_CHAIN. Paste the provider's root
# certificate here and verification works properly. On Supabase it is under
# Database, Configuration, Settings, SSL configuration, Download certificate;
# keep the double quotes and the newlines exactly as downloaded. The app and
# the db: scripts both use it (src/lib/database-tls.ts).
#
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----
# MIIEQTCCAqmgAwIBAgIUb0...
# -----END CERTIFICATE-----"
#
# The escape hatch, for a local afternoon and nothing else: connect encrypted
# without checking who answered. It prints a warning on every start, because
# anything sitting between the app and the database can present its own
# certificate and be believed.
# DATABASE_SSL_NO_VERIFY=yes

# Where the photographs go. This is the MinIO that docker compose starts, and
# it speaks the S3 protocol, so the same four settings point at a real bucket
# later without a line of code changing. Its own web viewer, if you want to see
# the objects, is http://localhost:19021 with the same user and password.
STORAGE_ENDPOINT=http://localhost:19020
STORAGE_BUCKET=daykeeper
# The region the S3 protocol demands. MinIO ignores it; a hosted bucket does
# not, and a signature made for the wrong region comes back as "signature does
# not match", which reads as a wrong-key error and is not. Leave it alone for
# local MinIO; set it to the bucket's region when pointing at a hosted one.
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=daykeeper
STORAGE_SECRET_KEY=daykeeper_local_dev

# The AWS SDK warns on every start that versions it publishes after January
# 2027 will want Node 22, which is after this project ends and is not a thing
# anyone here can act on. Silence it, because a warning printed every single
# time teaches people to stop reading warnings. Delete this line if the project
# ever outlives that date.
AWS_SDK_JS_NODE_VERSION_SUPPORT_WARNING_DISABLED=true

# Only needed when the app runs somewhere the browser cannot follow, such as
# inside a container: the server reaches storage at one address and the browser
# at another, and a link is signed for whichever host is written here. On a
# laptop the two are the same, so leave this alone.
# STORAGE_PUBLIC_ENDPOINT=http://localhost:19020

# Which reader to use.
#   mock    a stand-in that takes time, is sometimes unsure, and sometimes
#           fails, so the whole product can be built and demonstrated with no
#           credentials at all. This is the default and it is what you want.
#   azure   the real reader, on RACE's Azure AI Foundry. Needs the two
#           AZURE_ variables at the bottom of this file. Which model and
#           effort it uses is decided in docs/extraction.md.
#   openai  not implemented
#   bedrock not implemented
AI_EXTRACTION_PROVIDER=mock

# Which provider extracts commitments from prepared conversation transcripts.
# Keep this on mock while building the prototype without Azure credentials.
# Set it to azure only after the Module 3 extraction experiment is approved.
AI_VOICE_EXTRACTION_PROVIDER=mock

# Uncomment to make the mock reader answer instantly instead of taking its
# realistic two to seven seconds. The tests already set this to 0 on their own;
# in the browser you usually WANT the delay, because the waiting state is part
# of what is being built.
# MOCK_EXTRACTION_DELAY_MS=0

# Uncomment to make the voice mock answer instantly. Tests set this to 0.
# MOCK_VOICE_EXTRACTION_DELAY_MS=0

# The vision model, on RACE's Azure AI Foundry. Only the extraction experiment
# under experiments/ reads these today; the app still uses the mock reader
# until AI_EXTRACTION_PROVIDER says otherwise. The key is RMIT's, issued for
# this project. It never goes in this file, in a commit, or in a chat.
AZURE_OPENAI_ENDPOINT=https://az96-stem-sct.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=

# Optional Gmail prototype. Set private values in .env.local, never here.
# See docs/gmail-setup.md. No NEXT_PUBLIC_ prefix: all credentials stay server-side.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/email/gmail/callback
# 32 random bytes encoded as 64 hexadecimal characters; keep stable across restarts.
GMAIL_TOKEN_ENCRYPTION_KEY=
# KAN-91: how many model calls the school's key may make per day, across every
# account and every module, counted from midnight in Melbourne. A letter is two
# or three calls, so 200 is roughly 70 to 100 letters. The deployed
# site sets it (docs/deployment.md); a laptop leaves it unset and has no
# ceiling. Once reached, uploading answers 429 and reading resumes tomorrow.
# AI_DAILY_CALL_LIMIT=200
