# Synthetic letter images. Large binaries go through Git LFS so the clone
# stays small; teammates need git-lfs installed to see the pictures.
data/**/*.png filter=lfs diff=lfs merge=lfs -text

# The recorded demo inside a presentation. Video is the one kind of file in
# docs/ too large to keep as an ordinary blob.
docs/presentations/**/*.mp4 filter=lfs diff=lfs merge=lfs -text

# Generated migrations. The same bytes on every machine, whatever
# core.autocrlf says.
db/migrations/** text eol=lf

# The recording tests/db/http-characterisation.test.ts is held against. Vitest
# writes it with LF and rewrites a copy checked out with CRLF, after which Git
# reports a file that must never change as modified, with nothing in the diff.
tests/db/__snapshots__/** text eol=lf
