# Synthetic letter images. Large binaries go through Git LFS so the clone
# stays small; teammates need git-lfs installed to see the pictures.
data/**/*.png filter=lfs diff=lfs merge=lfs -text

# The recorded demo inside a presentation. Video is the one kind of file in
# docs/ too large to keep as an ordinary blob.
docs/presentations/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
