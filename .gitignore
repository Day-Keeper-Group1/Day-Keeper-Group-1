# local, never committed
CLAUDE.local.md
.env
.env.*
# The template is meant to be committed; it holds no secrets.
!.env.example
*.local

# python
__pycache__/
*.pyc
.venv/
.uv/

# node
node_modules/
dist/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Personal AI coding-agent tooling, which is nobody else's business.
# The one exception is .agents/skills, the standard location for skills a team
# checks in: those are project knowledge and belong in the repository.
.agents/*
!.agents/skills/
.claude/
skills-lock.json

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# large data stays out of git (shared drive instead); small curated fixtures/ are committed
output/
*.pdf
# except the walkthrough, which is a deliverable people read rather than data we
# happen to have. It is built from the typst sources beside it.
!docs/walkthrough/*.pdf

# Local uploads and build output
.storage/
