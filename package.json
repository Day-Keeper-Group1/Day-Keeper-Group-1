{
  "name": "day-keeper",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.17",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "worktree:setup": "node scripts/worktree-setup.mjs",
    "worktree:teardown": "node scripts/worktree-teardown.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "db:reset": "tsx db/reset.ts && tsx db/seed.ts && tsx scripts/storage-reset.ts",
    "db:schema": "tsx db/reset.ts",
    "db:seed": "tsx db/seed.ts",
    "storage:reset": "tsx scripts/storage-reset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write . --log-level warn",
    "format:check": "prettier --check . --log-level warn",
    "prepare": "husky",
    "m1:probe": "tsx experiments/module-01-extraction/shared/matrix.ts --probe",
    "m1:matrix": "tsx experiments/module-01-extraction/shared/matrix.ts",
    "m1:score": "tsx experiments/module-01-extraction/shared/score.ts",
    "m1:report": "tsx experiments/module-01-extraction/shared/report.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "openai": "^7.10.0",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.1",
    "swagger-ui-dist": "^5.32.15",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
